{
  "name": "locanara-rag-agent",
  "version": "1.0.0",
  "description": "Deterministic Locanara agent-context and llms.txt compiler",
  "type": "module",
  "scripts": {
    "compile": "bun run compile:ai",
    "compile:ai": "bun run compile-context.ts",
    "check": "bun run compile-context.ts --check",
    "check:versions": "bun run compile-context.ts --check-versions",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint:markdown": "bun run lint-markdown.ts",
    "lint": "bun run typecheck && bun run lint:markdown"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "glob": "^10.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "bun-types": "^1.3.6",
    "markdownlint-cli2": "^0.23.0",
    "typescript": "^5.9.2"
  }
}
